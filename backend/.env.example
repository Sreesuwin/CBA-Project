# Copy to .env and fill in real values. Never commit .env.

FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Both must be at least 32 bytes; PyJWT warns below that for HS256.
SECRET_KEY=replace_with_random_secret_of_at_least_32_bytes
JWT_SECRET_KEY=replace_with_random_jwt_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_MINUTES=60
# bcrypt cost factor. Each hash stores its own cost, so raising this later is safe.
BCRYPT_ROUNDS=12

# --- Database ---------------------------------------------------------------
# SQLite is the zero-setup default for local development and tests.
DATABASE_URL=sqlite:///loan_platform.db

# Cloud Postgres (Supabase): Project Settings > Database > Connection string.
# Session pooler URL (recommended for serverless/flaky networks, IPv4-safe):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection (faster long-lived backends; may need IPv6):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Local MySQL from database/loan_platform.sql:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/loan_platform
#
# The app also accepts bare postgres:// and mysql:// URLs and rewrites them to
# postgresql+psycopg2:// and mysql+pymysql:// respectively (see app/config.py).

# --- MongoDB (document metadata + audit logs) -------------------------------
# Leave MONGO_URI empty to run without MongoDB; audit/doc writes become no-ops.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=loan_platform

# --- Frontend ---------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
